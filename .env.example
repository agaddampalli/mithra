# LLM — primary + automatic fallback chain: Anthropic → Gemini → OpenAI
# Add keys for whichever providers you want active; unused providers are skipped.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=          # Google AI Studio: aistudio.google.com — free tier: 1M tokens/day
OPENAI_API_KEY=          # platform.openai.com — gpt-4o-mini used as final fallback

# Encryption
MITHRA_ENCRYPTION_KEY=         # base64-encoded 32-byte key
                               # generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"

# Storage
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=

# Messaging
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Set this when webhook is configured via setWebhook
# Leave empty to use polling mode (development)
TELEGRAM_WEBHOOK_URL=https://assistant.mithra-app.com/api/v1/webhook/telegram
# Your personal Telegram numeric ID — always authorized as admin (person_a).
# Find it by messaging @userinfobot on Telegram.
# Set this before first deploy so you can reach the bot before self-registering.
MITHRA_ADMIN_TELEGRAM_ID=
# WhatsApp session path is hardcoded in compose.yaml as /sessions/whatsapp

# Google OAuth — create at console.cloud.google.com
# Enable: Calendar API, Gmail API, People API, Google+ API
# Authorised redirect URI: https://assistant.mithra-app.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_CREDENTIALS=

# Base URL — used to build OAuth redirect URIs
MITHRA_BASE_URL=https://assistant.mithra-app.com

# Home Assistant
HA_URL=http://localhost:8123
HA_TOKEN=

# Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=

# App
# Required — used as API gateway auth token and LiteLLM master key
SECRET_KEY=
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM routing
# Set to false on machines where Ollama cannot run (< 6 GB Docker memory).
# All non-health tasks route directly to Anthropic cloud.
# Health domain is always local regardless of this setting.
# Remove or set to true when local hardware is available.
MITHRA_LOCAL_LLM_ENABLED=true
